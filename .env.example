# OmniAI — انسخ هذا الملف إلى .env.local واملأ ما تملكه فقط.
# لا تضع أي مفتاح هنا في مستودع عام. المفاتيح تُدخل من واجهة الموقع
# (مدير المفاتيح) وتُحفظ في متصفحك فقط، ولا تُرسل إلى أي خادم آخر
# غير مزود الذكاء الاصطناعي الذي اخترته.

# مفتاح افتراضي اختياري للخادم (إن أردت تشغيل الموقع بدون إدخال مفتاح في الواجهة)
# OPENAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# HF_TOKEN=

# رابط موجّه FreeLLMAPI المحلي (اختياري)
# FREELLMAPI_URL=http://localhost:3001/v1
